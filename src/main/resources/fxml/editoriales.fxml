<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="16" styleClass="gestor">
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="buscar" promptText="Buscar por nombre o país" HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="incluirInactivos" text="Incluir inactivas"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    </VBox>
    <VBox spacing="8" prefWidth="320" minWidth="320" maxWidth="320" maxHeight="-Infinity" styleClass="card">
        <Label fx:id="tituloFormulario" styleClass="subtitulo"/>
        <Label text="Nombre *"/>
        <TextField fx:id="nombre"/>
        <Label text="País"/>
        <TextField fx:id="pais"/>
        <Label text="Sitio web (https://...)"/>
        <TextField fx:id="sitioWeb"/>
        <Label fx:id="error" styleClass="mensaje-error" wrapText="true" maxWidth="Infinity"/>
        <Button fx:id="btnGuardar" text="Guardar" maxWidth="Infinity" styleClass="boton-primario"/>
        <HBox spacing="8">
            <Button fx:id="btnNuevo" text="Nuevo" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="boton-secundario"/>
            <Button fx:id="btnEstado" text="Desactivar" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="boton-secundario"/>
        </HBox>
    </VBox>
</HBox>