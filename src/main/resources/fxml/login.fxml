<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="root-pane">
    <VBox alignment="TOP_CENTER" spacing="8" prefWidth="380" maxWidth="380" maxHeight="-Infinity" styleClass="card">
        <ImageView fx:id="logo" fitHeight="140" preserveRatio="true"/>
        <Label text="Iniciar sesión" styleClass="titulo"/>
        <Label text="Correo electrónico" maxWidth="Infinity"/>
        <TextField fx:id="email" promptText="nombre@correo.com"/>
        <Label text="Contraseña" maxWidth="Infinity"/>
        <PasswordField fx:id="password" onAction="#ingresar"/>
        <Label fx:id="error" styleClass="mensaje-error" wrapText="true" maxWidth="Infinity"/>
        <Button text="Ingresar" defaultButton="true" maxWidth="Infinity" styleClass="boton-primario" onAction="#ingresar"/>
    </VBox>
</StackPane>